# Molecule platform image with systemd as PID 1
#
# Shared by the Molecule scenarios that test services (kafka, elasticsearch,
# phoebus_alarm_logger): with a real systemd the roles run with
# in_container=false, i.e. exactly as on a VM, and the tests can check that
# the services are actually running and working.
# Needs a privileged container sharing the host's cgroup namespace - see the
# platform definitions in the scenarios' molecule.yml.
FROM {{ item.image }}

ENV container=docker
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus \
      python3 python3-apt sudo ca-certificates \
      git tar gzip unzip curl iproute2 procps \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Units that make no sense (or hang) in a container
RUN rm -f /lib/systemd/system/multi-user.target.wants/getty.target \
          /lib/systemd/system/sysinit.target.wants/systemd-firstboot.service \
          /lib/systemd/system/sysinit.target.wants/systemd-udevd.service \
          /lib/systemd/system/sysinit.target.wants/sys-fs-fuse-connections.mount \
          /lib/systemd/system/local-fs.target.wants/systemd-remount-fs.service \
 && systemctl mask systemd-logind.service getty.target console-getty.service

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
