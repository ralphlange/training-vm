# {{ ansible_managed }}
[Unit]
Description=Elasticsearch (single node) for the Phoebus alarm logger
Documentation=https://www.elastic.co
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ elasticsearch_user }}
Group={{ elasticsearch_group }}

Environment="ES_PATH_CONF={{ elasticsearch_config_dir }}"
Environment="ES_JAVA_OPTS={{ elasticsearch_heap_opts }}"

ExecStart={{ elasticsearch_home }}/bin/elasticsearch
# A JVM receiving SIGTERM exits with 143
SuccessExitStatus=143
TimeoutStopSec=60

LimitNOFILE=65535
LimitNPROC=4096

Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
